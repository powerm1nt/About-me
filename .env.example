# Frontend build-time configuration. Copy to `.env.local` for local development.
#
# Leave VITE_API_BASE_URL empty in development: vite proxies /api to the local Server
# (see vite.config.ts), which keeps the browser same-origin so CORS and the OAuth returnUrl
# allow-list don't need a dev-specific entry. Production also leaves this empty because Express
# serves the frontend and /api from the same Cloud Run origin.
VITE_API_BASE_URL=

# Host serving the site's images and markdown. Must include the object prefix.
# Points straight at the bucket while the hisuiki CDN is still to be built; swap it for the CDN
# hostname once the new load balancer exists.
VITE_ASSET_BASE_URL=https://storage.googleapis.com/hisuiki-assets-prod/static

# Where `pnpm dev` proxies /api to — the API's local port (see server/.env.example).
# Defaults to this when unset.
VITE_DEV_API_TARGET=http://localhost:5066
