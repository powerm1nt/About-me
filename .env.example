# Frontend build-time configuration. Copy to `.env.local` for local development.
#
# Leave VITE_API_BASE_URL empty in development: vite proxies /api to the local Server
# (see vite.config.ts), which keeps the browser same-origin so CORS and the OAuth returnUrl
# allow-list don't need a dev-specific entry. In CI the deploy workflow sets it from the
# API_BASE_URL repository variable (the Cloud Run service URL).
VITE_API_BASE_URL=

# CDN host serving the site's images and markdown. Must include the object prefix.
VITE_ASSET_BASE_URL=https://nwrks-cdn.public.prod.nuka.works/static

# Where `pnpm dev` proxies /api to — the API's local port (see server/.env.example).
# Defaults to this when unset.
VITE_DEV_API_TARGET=http://localhost:5066
