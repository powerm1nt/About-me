# Frontend build-time configuration. Copy to `.env.local` for local development.
#
# Leave VITE_API_BASE_URL empty in development: vite proxies /api to the local Server
# (see vite.config.ts), which keeps the browser same-origin so CORS and the OAuth returnUrl
# allow-list don't need a dev-specific entry. Production also leaves this empty because Express
# serves the frontend and /api from the same Cloud Run origin.
# Empty in development (Vite proxies /api to the local API, keeping the browser same-origin).
# In production this is the API's own host, since the two are separate services:
#   VITE_API_BASE_URL=https://api.hisuiki.com
VITE_API_BASE_URL=

# CDN host serving the site's images and markdown. Must include the object prefix.
VITE_ASSET_BASE_URL=https://cdn.hisuiki.com/static

# Where `pnpm dev` proxies /api to — the API's local port (see server/.env.example).
# Defaults to this when unset.
VITE_DEV_API_TARGET=http://localhost:5066

# ── Social sign-in, for the local stack ───────────────────────────────────────
# Read by docker-compose.dev.yml. Leave them empty and the sign-in page offers email and password
# only: a provider without a client id is not registered, so pressing its button cannot fail.
#
# The callback URL to register with the provider is the address you actually open the app on, plus
# /api/auth/callback/<provider> — the frontend proxies /api to the API, so it is the frontend's
# origin and port, not the API's. On this machine that means:
#
#   http://10.100.50.7:5173/api/auth/callback/github
#   http://10.100.50.7:5173/api/auth/callback/google
#
# GitHub allows one callback URL per OAuth application, so a LAN address and localhost need two
# applications. Google accepts several redirect URIs on one client.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
