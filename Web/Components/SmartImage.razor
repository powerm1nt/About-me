<div class="smart-img-wrap @(Block ? "is-block" : "")" style="@WrapStyle">
    @if (_state == LoadState.Loading)
    {
        <span class="skeleton smart-img-skeleton"
              style="width:@(Width ?? "100%"); height:@(Height ?? "2em")"
              aria-hidden="true"></span>
    }
    else if (_state == LoadState.Error)
    {
        <div class="smart-img-error" style="@SizeStyle" role="img" aria-label="@($"Image unavailable: {Alt}")">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="0" />
                <line x1="9"  y1="9"  x2="15" y2="15" />
                <line x1="15" y1="9"  x2="9"  y2="15" />
            </svg>
            <span>@(Alt ?? "image unavailable")</span>
        </div>
    }

    @* Always render the img; hidden until loaded, removed from flow on error *@
    <img src="@Src"
         alt="@Alt"
         width="@Width"
         height="@Height"
         style="@($"{SizeStyle}; display:{(_state == LoadState.Loaded ? "block" : "none")}; {Style}")"
         @onload="OnLoad"
         @onerror="OnError" />
</div>

@code {
    [Parameter, EditorRequired] public string Src    { get; set; } = string.Empty;
    [Parameter] public string? Alt    { get; set; }
    [Parameter] public string? Width  { get; set; }
    [Parameter] public string? Height { get; set; }
    [Parameter] public string  Style  { get; set; } = string.Empty;
    /// <summary>When true, the wrapper is display:block (full-width). Default: inline.</summary>
    [Parameter] public bool    Block  { get; set; }

    private enum LoadState { Loading, Loaded, Error }
    private LoadState _state = LoadState.Loading;

    private string SizeStyle =>
        string.Join("; ", new[]
        {
            Width  is not null ? $"width:{Width}"   : null,
            Height is not null ? $"height:{Height}" : null,
        }.OfType<string>());

    private string WrapStyle =>
        Width  is not null ? $"width:{Width}" : string.Empty;

    private void OnLoad()  => _state = LoadState.Loaded;
    private void OnError() => _state = LoadState.Error;
}
