@inject Web.Services.ExternalLinkState LinkState

<a href="@Href" target="_blank" rel="noreferrer" class="@Class" @onclick="HandleClick" @onclick:preventDefault>
    @ChildContent
</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void HandleClick() => LinkState.Request(Href, Label);
}
