@inject HttpClient Http
@inject Web.Services.AuthService Auth
@implements IDisposable
@using Shared.Dto
@using Web.Components

@attribute [MdComponent("blog-index")]

<div class="blog-index-container">
    <div class="blog-index-header">
        <h2>Articles</h2>
        @if (!_isCreating)
        {
            <button type="button" class="editor-btn editor-btn-primary" @onclick="StartCreating">
                + Add new article
            </button>
        }
    </div>

    @if (_isCreating)
    {
        <PageEditor IsNewFile="true" IsJapanese="@IsJapanese" OnClose="CloseCreating" />
    }
    else if (_loading)
    {
        <div class="blog-index-list" aria-hidden="true">
            @for (int i = 0; i < 4; i++)
            {
                <div class="blog-index-card">
                    <Skeleton Class="skeleton-title" Width="55%" />
                    <Skeleton Class="skeleton-line"  Width="80%" />
                    <Skeleton Class="skeleton-meta"  Width="100px" />
                </div>
            }
        </div>
    }
    else if (_error is not null)
    {
        <p class="loading-text" style="color:red">Error loading articles: @_error</p>
    }
    else if (_articles.Count == 0)
    {
        <p class="loading-text">No articles found.</p>
    }
    else
    {
        <div class="blog-index-list">
            @foreach (var art in _articles)
            {
                <article class="blog-index-card">
                    <h3 class="blog-card-title">
                        <a href="@ArticleRoute(art.FilePath)">
                            @art.Title
                        </a>
                    </h3>
                    @if (!string.IsNullOrEmpty(art.Description))
                    {
                        <p class="blog-card-desc">@art.Description</p>
                    }
                    <div class="blog-card-meta">
                        @if (!string.IsNullOrEmpty(art.Author))
                        {
                            <span class="blog-card-author">By @art.Author</span>
                        }
                        @if (!string.IsNullOrEmpty(art.LastEdited))
                        {
                            <span class="blog-card-last-edited" title="@($"Created: {art.Created ?? art.LastEdited}")">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10" />
                                    <polyline points="12 6 12 12 16 14" />
                                </svg>
                                @art.LastEdited
                            </span>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool IsJapanese { get; set; }

    private List<ArticleMetadataDto> _allArticles = [];
    private List<ArticleMetadataDto> _articles = [];
    private bool _loading = true;
    private bool _prevIsJapanese;
    private string? _error;
    private bool _isCreating;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += OnAuthChanged;

        // FileViewer already called Auth.InitializeAsync() once for this page load (it mounts
        // before this component does) — read what it found instead of consuming the URL again.
        if (Auth.PendingResumeAction == "create")
            _isCreating = true;

        await LoadArticlesAsync();
    }

    private void StartCreating()
    {
        if (!Auth.IsSignedIn)
        {
            Auth.RedirectToLogin("create");
            return;
        }

        _isCreating = true;
    }

    private void CloseCreating() => _isCreating = false;

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.OnChange -= OnAuthChanged;

    protected override Task OnParametersSetAsync()
    {
        if (_prevIsJapanese != IsJapanese)
        {
            _prevIsJapanese = IsJapanese;
            FilterArticles();
        }
        return Task.CompletedTask;
    }

    private async Task LoadArticlesAsync()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<ArticleMetadataDto>>("/api/pages/articles");
            _allArticles = all ?? [];
            FilterArticles();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void FilterArticles()
    {
        _articles = _allArticles
            .Where(a =>
                a.FilePath.StartsWith("blog/") &&
                a.FilePath != "blog/index.md" &&
                a.FilePath != "blog/index.ja.md" &&
                (IsJapanese ? a.FilePath.EndsWith(".ja.md") : !a.FilePath.EndsWith(".ja.md")))
            .ToList();
    }

    private static string ArticleRoute(string filePath)
    {
        var isJa = filePath.EndsWith(".ja.md");
        var name = filePath.StartsWith("blog/") ? filePath["blog/".Length..] : filePath;
        name = isJa ? name[..^".ja.md".Length] : name[..^".md".Length];
        return isJa ? $"/blog/{name}/ja" : $"/blog/{name}";
    }
}
