@inject Web.Services.ExternalLinkState LinkState
@inject IJSRuntime JS
@implements IDisposable

@if (_pending is not null)
{
    <div class="app-modal-overlay @(_closing ? "is-closing" : "")" @onclick="Cancel">
        <div class="app-modal @(_closing ? "is-closing" : "")" role="alertdialog" aria-modal="true" aria-labelledby="app-modal-title" @ref="_modalRef" @onclick:stopPropagation="true">
            <p class="app-modal-kicker">leaving nuka.works</p>
            <h2 class="app-modal-title" id="app-modal-title">@_pending.Label</h2>
            <p class="app-modal-message">You're about to open an external link outside this site.</p>
            <p class="app-modal-url">@_pending.Url</p>
            <div class="app-modal-actions">
                <button type="button" class="app-modal-btn" @ref="_cancelButtonRef" @onclick="Cancel">cancel</button>
                <button type="button" class="app-modal-btn app-modal-btn-confirm" @onclick="Confirm">continue</button>
            </div>
        </div>
    </div>
}

@code {
    private const int CloseAnimationMs = 180;

    private Web.Services.PendingLink? _pending;
    private bool _closing;
    private bool _shouldFocusCancel;
    private ElementReference _cancelButtonRef;
    private ElementReference _modalRef;

    protected override void OnInitialized() => LinkState.OnChange += HandleChange;

    private void HandleChange(Web.Services.PendingLink? pending)
    {
        if (pending is null) return; // closing is driven locally by CloseWithAnimation
        _pending = pending;
        _closing = false;
        _shouldFocusCancel = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_shouldFocusCancel) return;
        _shouldFocusCancel = false;
        await _cancelButtonRef.FocusAsync();
        await JS.InvokeVoidAsync("attachFocusTrap", _modalRef);
    }

    private Task Cancel() => CloseWithAnimation();

    private async Task Confirm()
    {
        var url = _pending!.Url;
        await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
        await CloseWithAnimation();
    }

    private async Task CloseWithAnimation()
    {
        if (_pending is null || _closing) return;

        _closing = true;
        StateHasChanged();
        await Task.Delay(CloseAnimationMs);

        await JS.InvokeVoidAsync("detachFocusTrap", _modalRef);
        _closing = false;
        _pending = null;
        LinkState.Clear();
    }

    public void Dispose() => LinkState.OnChange -= HandleChange;
}
