@inject HttpClient Http
@inject Web.Services.AuthService Auth
@inject IJSRuntime JS
@using System.Text.RegularExpressions

<div class="page-editor">
    @if (_state == EditorState.Loading)
    {
        <div class="editor-skeleton" aria-hidden="true">
            <div class="editor-skeleton-tabs">
                <Skeleton Class="skeleton-tab" Width="70px" />
                <Skeleton Class="skeleton-tab" Width="80px" />
            </div>
            <Skeleton Class="skeleton-editor-block" Width="100%" />
            <div class="editor-skeleton-fields">
                <Skeleton Class="skeleton-field" Width="100%" />
                <Skeleton Class="skeleton-field-lg" Width="100%" />
            </div>
            <div class="editor-skeleton-actions">
                <Skeleton Class="skeleton-action" Width="90px" />
                <Skeleton Class="skeleton-action" Width="160px" />
            </div>
        </div>
    }
    else if (_state == EditorState.Success)
    {
        <div class="editor-success">
            <p>Proposal opened — <ExternalLink Href="@_result!.PullRequestUrl" Label="Pull Request on GitHub">view the pull request on GitHub</ExternalLink>.</p>
            <button type="button" class="editor-btn editor-btn-primary" @onclick="Close">Done</button>
        </div>
    }
    else
    {
        @if (IsNewFile)
        {
            <div class="editor-slug-field">
                <label for="new-article-slug">URL slug</label>
                <input id="new-article-slug" class="editor-slug-input" placeholder="my-first-post"
                       @bind="_slug" @bind:event="oninput" maxlength="80" />
                <span class="editor-slug-preview">→ @EffectivePath</span>
                @if (!string.IsNullOrEmpty(_slug) && !IsSlugValid)
                {
                    <span class="editor-slug-error">Lowercase letters, numbers and hyphens only (e.g. "my-first-post").</span>
                }
            </div>
        }

        <div class="editor-tabs">
            <button type="button" class="editor-tab @(_activeTab == EditorTab.Write ? "is-active" : "")"
                    @onclick='() => SetTab(EditorTab.Write)'>Write</button>
            <button type="button" class="editor-tab @(_activeTab == EditorTab.Preview ? "is-active" : "")"
                    @onclick='() => SetTab(EditorTab.Preview)'>Preview</button>
        </div>

        <div class="editor-pane" style="@(_activeTab == EditorTab.Write ? "" : "display:none")">
            <div class="editor-toolbar" role="toolbar" aria-label="Formatting">
                <button type="button" class="toolbar-btn toolbar-btn-bold" title="Bold" @onclick='() => WrapSelectionAsync("**", "**", "bold text")'>B</button>
                <button type="button" class="toolbar-btn toolbar-btn-italic" title="Italic" @onclick='() => WrapSelectionAsync("*", "*", "italic text")'>I</button>
                <button type="button" class="toolbar-btn" title="Heading" @onclick='() => PrefixLinesAsync("## ")'>H</button>
                <span class="toolbar-sep"></span>
                <button type="button" class="toolbar-btn" title="Link" @onclick='() => WrapSelectionAsync("[", "](https://)", "link text")'>Link</button>
                <button type="button" class="toolbar-btn" title="Image" @onclick='() => WrapSelectionAsync("![", "](https://)", "alt text")'>Image</button>
                <button type="button" class="toolbar-btn toolbar-btn-code" title="Inline code" @onclick='() => WrapSelectionAsync("`", "`", "code")'>Code</button>
                <span class="toolbar-sep"></span>
                <button type="button" class="toolbar-btn" title="Quote" @onclick='() => PrefixLinesAsync("> ")'>Quote</button>
                <button type="button" class="toolbar-btn" title="Bulleted list" @onclick='() => PrefixLinesAsync("- ")'>List</button>
                <button type="button" class="toolbar-btn" title="Numbered list" @onclick='() => PrefixLinesAsync(numbered: true)'>1. List</button>
            </div>
            <StandaloneCodeEditor @ref="_editor" Id="page-editor-monaco" CssClass="page-editor-monaco"
                                   ConstructionOptions="EditorOptions" OnDidInit="RegisterShortcutsAsync" />
        </div>

        @if (_activeTab == EditorTab.Preview)
        {
            <div class="editor-pane editor-preview">
                @if (_previewHtml is null)
                {
                    <div aria-hidden="true">
                        <Skeleton Class="skeleton-title" Width="55%" />
                        <Skeleton Class="skeleton-line" Width="100%" />
                        <Skeleton Class="skeleton-line" Width="92%" />
                        <Skeleton Class="skeleton-line" Width="97%" />
                        <Skeleton Class="skeleton-line" Width="70%" />
                    </div>
                }
                else
                {
                    <MdContentRenderer Html="@_previewHtml" IsJapanese="@IsJapanese" />
                }
            </div>
        }

        <div class="editor-fields">
            <input class="editor-commit-input" placeholder="Commit message (required)"
                   @bind="_commitMessage" @bind:event="oninput" maxlength="120" />
            <textarea class="editor-description-input" placeholder="Description (optional)" rows="3"
                      @bind="_description" @bind:event="oninput"></textarea>
        </div>

        @if (_error is not null)
        {
            <InfoBubble Title="@($"Could not propose changes: {_error}")" />
        }

        <div class="editor-actions">
            <button type="button" class="editor-btn editor-btn-cancel" @onclick="Close"
                    disabled="@(_state == EditorState.Submitting)">Cancel</button>
            <button type="button" class="editor-btn editor-btn-primary" @onclick="Propose" disabled="@(!CanPropose)">
                @(_state == EditorState.Submitting ? "Opening pull request…" : "Propose changes")
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string FilePath { get; set; } = string.Empty;
    [Parameter] public bool IsJapanese { get; set; }
    [Parameter] public bool IsNewFile { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly Regex SlugPattern = new(@"^[a-z0-9]+(-[a-z0-9]+)*$");

    private enum EditorState { Loading, Editing, Submitting, Success }
    private enum EditorTab { Write, Preview }

    private EditorState _state = EditorState.Loading;
    private EditorTab _activeTab = EditorTab.Write;
    private StandaloneCodeEditor? _editor;
    private string _rawContent = string.Empty;
    private string _slug = string.Empty;
    private string _commitMessage = string.Empty;
    private string _description = string.Empty;
    private string? _previewHtml;
    private string? _error;
    private bool _loadFailed;
    private ProposalResultDto? _result;

    private string EffectivePath => IsNewFile ? $"blog/{_slug}{(IsJapanese ? ".ja" : string.Empty)}.md" : FilePath;
    private bool IsSlugValid => SlugPattern.IsMatch(_slug);

    private bool CanPropose =>
        _state == EditorState.Editing && !_loadFailed && !string.IsNullOrWhiteSpace(_commitMessage) &&
        (!IsNewFile || IsSlugValid);

    protected override async Task OnInitializedAsync()
    {
        // Kick off Monaco's script load in parallel with fetching the page content —
        // it's only pulled in here, not on every page load, since anonymous readers never need it.
        var monacoTask = JS.InvokeVoidAsync("loadMonacoAssets").AsTask();

        if (IsNewFile)
        {
            _rawContent = BuildNewArticleTemplate();
        }
        else
        {
            try
            {
                var raw = await Http.GetFromJsonAsync<PageRawDto>($"/api/pages/raw?path={Uri.EscapeDataString(FilePath)}");
                _rawContent = raw?.RawContent ?? string.Empty;
            }
            catch (Exception ex)
            {
                _error = $"Could not load page content ({ex.Message}).";
                _loadFailed = true;
            }
        }

        await monacoTask;
        _state = EditorState.Editing;
    }

    // Cross-author support: a new article's frontmatter is stamped with whoever is actually
    // signed in via GitHub, not a fixed site-owner name — "Display Name (login)" when GitHub has
    // a display name set, otherwise just the login.
    private string BuildNewArticleTemplate()
    {
        var author = AuthorDisplayName().Replace("\"", "\\\"");
        return $"---\ntitle: \"\"\ndescription: \"\"\nauthor: \"{author}\"\n---\n\n";
    }

    private string AuthorDisplayName()
    {
        var user = Auth.CurrentUser;
        if (user is null) return string.Empty;
        return string.IsNullOrEmpty(user.Name) ? user.Login : $"{user.Name} ({user.Login})";
    }

    private static readonly Regex NumberedListPrefix = new(@"^\d+\.\s+");

    // Registers Ctrl/Cmd+B, +I and +K to trigger the same wrap actions as the toolbar buttons,
    // once the underlying Monaco instance is actually ready (fires from StandaloneCodeEditor's
    // OnDidInit, not construction — AddCommand needs a live editor).
    private async Task RegisterShortcutsAsync()
    {
        if (_editor is null) return;

        await _editor.AddCommand((int)KeyMod.CtrlCmd | (int)KeyCode.KeyB, args => { _ = WrapSelectionAsync("**", "**", "bold text"); }, null);
        await _editor.AddCommand((int)KeyMod.CtrlCmd | (int)KeyCode.KeyI, args => { _ = WrapSelectionAsync("*", "*", "italic text"); }, null);
        await _editor.AddCommand((int)KeyMod.CtrlCmd | (int)KeyCode.KeyK, args => { _ = WrapSelectionAsync("[", "](https://)", "link text"); }, null);
    }

    // Wraps the current selection with prefix/suffix (e.g. "**bold**"). If the selection already
    // carries the markers — either selected along with the text ("**bold**" fully selected) or
    // sitting immediately outside it ("bold" selected inside "**bold**") — removes them instead,
    // so clicking the same action twice toggles the formatting off. Inserts placeholder text when
    // nothing is selected, so the toolbar always produces valid markdown to type over.
    private async Task WrapSelectionAsync(string prefix, string suffix, string placeholder)
    {
        if (_editor is null) return;

        var selection = await _editor.GetSelection();
        var model = await _editor.GetModel();
        if (selection is null || model is null) return;

        var range = new BlazorMonaco.Range(selection.StartLineNumber, selection.StartColumn, selection.EndLineNumber, selection.EndColumn);
        var hasSelection = range.StartLineNumber != range.EndLineNumber || range.StartColumn != range.EndColumn;

        if (!hasSelection)
        {
            await ReplaceRangeAsync(range, $"{prefix}{placeholder}{suffix}");
            return;
        }

        var selectedText = await model.GetValueInRange(range, EndOfLinePreference.TextDefined);

        if (selectedText.Length >= prefix.Length + suffix.Length &&
            selectedText.StartsWith(prefix, StringComparison.Ordinal) &&
            selectedText.EndsWith(suffix, StringComparison.Ordinal))
        {
            await ReplaceRangeAsync(range, selectedText[prefix.Length..^suffix.Length]);
            return;
        }

        var before = await GetCharsBeforeAsync(model, range, prefix.Length);
        var after = await GetCharsAfterAsync(model, range, suffix.Length);
        if (before == prefix && after == suffix)
        {
            var expanded = new BlazorMonaco.Range(range.StartLineNumber, range.StartColumn - prefix.Length, range.EndLineNumber, range.EndColumn + suffix.Length);
            await ReplaceRangeAsync(expanded, selectedText);
            return;
        }

        await ReplaceRangeAsync(range, $"{prefix}{selectedText}{suffix}");
    }

    // Prefixes every line touched by the current selection (e.g. "> " for a quote). Numbered
    // lists get a sequential "1. ", "2. ", ... prefix instead of a fixed marker. If every touched
    // line already carries the marker, strips it instead — toggles the same way WrapSelectionAsync does.
    private async Task PrefixLinesAsync(string marker = "", bool numbered = false)
    {
        if (_editor is null) return;

        var selection = await _editor.GetSelection();
        var model = await _editor.GetModel();
        if (selection is null || model is null) return;

        var range = new BlazorMonaco.Range(selection.StartLineNumber, 1, selection.EndLineNumber, int.MaxValue);
        var block = await model.GetValueInRange(range, EndOfLinePreference.TextDefined);
        var lines = block.Split('\n');

        string[] newLines;
        if (numbered)
        {
            var alreadyNumbered = lines.All(l => NumberedListPrefix.IsMatch(l));
            newLines = alreadyNumbered
                ? lines.Select(l => NumberedListPrefix.Replace(l, "")).ToArray()
                : lines.Select((l, i) => $"{i + 1}. {l}").ToArray();
        }
        else
        {
            var alreadyMarked = lines.All(l => l.StartsWith(marker, StringComparison.Ordinal));
            newLines = alreadyMarked
                ? lines.Select(l => l[marker.Length..]).ToArray()
                : lines.Select(l => $"{marker}{l}").ToArray();
        }

        await ReplaceRangeAsync(range, string.Join('\n', newLines));
    }

    private async Task ReplaceRangeAsync(BlazorMonaco.Range range, string text)
    {
        if (_editor is null) return;
        // Monaco throws internally ("Cannot read properties of undefined (reading 'modelState')")
        // if endCursorState is an empty array — it must be null/omitted or a non-empty selection list.
        await _editor.ExecuteEdits("toolbar", [new IdentifiedSingleEditOperation { Range = range, Text = text }], (List<Selection>?)null);
        await _editor.Focus();
    }

    private static async Task<string> GetCharsBeforeAsync(TextModel model, BlazorMonaco.Range range, int count)
    {
        if (count == 0 || range.StartColumn - count < 1) return string.Empty;
        var probe = new BlazorMonaco.Range(range.StartLineNumber, range.StartColumn - count, range.StartLineNumber, range.StartColumn);
        return await model.GetValueInRange(probe, EndOfLinePreference.TextDefined);
    }

    private static async Task<string> GetCharsAfterAsync(TextModel model, BlazorMonaco.Range range, int count)
    {
        if (count == 0) return string.Empty;
        var probe = new BlazorMonaco.Range(range.EndLineNumber, range.EndColumn, range.EndLineNumber, range.EndColumn + count);
        return await model.GetValueInRange(probe, EndOfLinePreference.TextDefined);
    }

    private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor editor) => new()
    {
        AutomaticLayout = true,
        Language = "markdown",
        Value = _rawContent,
        WordWrap = "on",
        Theme = "vs-dark"
    };

    private async Task SetTab(EditorTab tab)
    {
        _activeTab = tab;
        if (tab == EditorTab.Preview)
            await RefreshPreviewAsync();
    }

    private async Task RefreshPreviewAsync()
    {
        _previewHtml = null;
        StateHasChanged();

        var markdown = _editor is not null ? await _editor.GetValue() : _rawContent;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/pages/preview", new PagePreviewRequestDto { Markdown = markdown });
            var result = await response.Content.ReadFromJsonAsync<PagePreviewResultDto>();
            _previewHtml = result?.Html ?? string.Empty;
        }
        catch (Exception ex)
        {
            _previewHtml = $"<p class=\"editor-status\">Preview failed: {System.Net.WebUtility.HtmlEncode(ex.Message)}</p>";
        }

        StateHasChanged();
    }

    private async Task Propose()
    {
        if (!CanPropose || _editor is null) return;

        _state = EditorState.Submitting;
        _error = null;
        StateHasChanged();

        try
        {
            var newContent = await _editor.GetValue();
            var request = Auth.WithSession(new HttpRequestMessage(HttpMethod.Post, "/api/proposals")
            {
                Content = JsonContent.Create(new ProposalRequestDto
                {
                    Path = EffectivePath,
                    NewContent = newContent,
                    CommitMessage = _commitMessage.Trim(),
                    Description = _description.Trim()
                })
            });

            var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                var problem = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                _error = problem is not null && problem.TryGetValue("error", out var message)
                    ? message
                    : $"HTTP {(int)response.StatusCode}";
                _state = EditorState.Editing;
                return;
            }

            _result = await response.Content.ReadFromJsonAsync<ProposalResultDto>();
            _state = EditorState.Success;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _state = EditorState.Editing;
        }
    }

    private Task Close() => OnClose.InvokeAsync();
}
