@using System.Text.RegularExpressions
@using System.Reflection
@inject Web.Services.MdComponentRegistry Registry

@foreach (var segment in _segments)
{
    if (segment.IsHtml)
    {
        @((MarkupString)segment.Content)
    }
    else
    {
        var componentType = Registry.Resolve(segment.Type);
        if (componentType is not null)
        {
            var parameters = BuildParameters(componentType, segment);
            <DynamicComponent Type="@componentType" Parameters="@parameters" />
        }
    }
}

@code {
    [Parameter, EditorRequired] public string Html { get; set; } = string.Empty;
    [Parameter] public bool IsJapanese { get; set; }

    private List<Segment> _segments = [];

    // Matches: <!--md-component:type:title-->...body...<!--/md-component-->
    // Type may contain hyphens (e.g. "blog-index"); title ends at -->
    private static readonly Regex SentinelRx = new(
        @"<!--md-component:([\w-]+):([^>]*?)-->([\s\S]*?)<!--/md-component-->",
        RegexOptions.Compiled);

    protected override void OnParametersSet()
    {
        _segments = Parse(Html);
    }

    private static List<Segment> Parse(string html)
    {
        var result = new List<Segment>();
        var lastIndex = 0;

        foreach (Match m in SentinelRx.Matches(html))
        {
            if (m.Index > lastIndex)
                result.Add(new Segment(html[lastIndex..m.Index], true, string.Empty, string.Empty));

            result.Add(new Segment(m.Groups[3].Value, false, m.Groups[1].Value, m.Groups[2].Value));
            lastIndex = m.Index + m.Length;
        }

        if (lastIndex < html.Length)
            result.Add(new Segment(html[lastIndex..], true, string.Empty, string.Empty));

        return result;
    }

    // Build a parameters dict containing only what the target component actually declares.
    private Dictionary<string, object?> BuildParameters(Type componentType, Segment segment)
    {
        // Collect all [Parameter] property names on the component
        var declared = componentType
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => p.GetCustomAttribute<Microsoft.AspNetCore.Components.ParameterAttribute>() is not null)
            .Select(p => p.Name)
            .ToHashSet(StringComparer.Ordinal);

        var p = new Dictionary<string, object?>();

        if (declared.Contains("IsJapanese"))
            p["IsJapanese"] = IsJapanese;

        if (declared.Contains("Title"))
            p["Title"] = segment.Title;

        if (declared.Contains("Class"))
            p["Class"] = $"md-component md-component-{segment.Type}";

        if (declared.Contains("ChildContent") && !string.IsNullOrEmpty(segment.Content))
        {
            var html = segment.Content; // capture for lambda
            p["ChildContent"] = (RenderFragment)(builder =>
            {
                builder.AddMarkupContent(0, html);
            });
        }

        return p;
    }

    private record Segment(string Content, bool IsHtml, string Type, string Title);
}

