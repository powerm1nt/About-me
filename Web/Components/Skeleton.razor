<span class="skeleton @Class"
      style="@StyleStr"
      aria-hidden="true"></span>

@code {
    /// <summary>Extra CSS classes (e.g. "skeleton-line", "skeleton-title").</summary>
    [Parameter] public string Class { get; set; } = "skeleton-line";
    [Parameter] public string? Width  { get; set; }
    [Parameter] public string? Height { get; set; }

    private string StyleStr =>
        string.Join(";", new[]
        {
            Width  is not null ? $"width:{Width}"   : null,
            Height is not null ? $"height:{Height}" : null,
        }.Where(s => s is not null));
}
