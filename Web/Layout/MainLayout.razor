@inherits LayoutComponentBase
@inject Web.Services.AssetService Assets
@inject Web.Services.LanguageState LangState
@inject Web.Services.WallpaperPaletteService Wallpaper

<CascadingValue Value="LangState">
    <AppHeader />
    @Body
    <AppFooter />
    <AppModal />
</CascadingValue>

@code {
    // Only wallpaper set today, but ApplyWallpaperAsync is safe to call again later
    // (e.g. from a future appearance picker) — it re-derives the whole accent/text
    // palette from whatever image it's pointed at.
    private const string DefaultWallpaperUrl = "/assets/default2.png";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Assets.InjectCssVariablesAsync();
            await Wallpaper.ApplyWallpaperAsync(DefaultWallpaperUrl);
        }
    }
}
