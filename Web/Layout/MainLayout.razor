@inherits LayoutComponentBase
@inject Web.Services.AssetService Assets
@inject Web.Services.LanguageState LangState
@inject Web.Services.DailyWallpaperService DailyWallpaper
@inject Web.Services.WallpaperPaletteService Wallpaper

<CascadingValue Value="LangState">
    <AppHeader />
    @Body
    <AppFooter />
    <AppModal />
</CascadingValue>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Assets.InjectCssVariablesAsync();
            // Today's Bing wallpaper (falls back to the bundled static image if Server/Bing is
            // unreachable) — ApplyWallpaperAsync is safe to call again later too (e.g. from a
            // future appearance picker), re-deriving the whole accent/text palette each time.
            var wallpaperUrl = await DailyWallpaper.ResolveWallpaperUrlAsync();
            await Wallpaper.ApplyWallpaperAsync(wallpaperUrl);
        }
    }
}
