@inherits LayoutComponentBase
@inject Web.Services.AssetService Assets
@inject Web.Services.LanguageState LangState

<CascadingValue Value="LangState">
    <AppHeader />
    @Body
    <AppFooter />
    <AppModal />
</CascadingValue>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Assets.InjectCssVariablesAsync();
    }
}
