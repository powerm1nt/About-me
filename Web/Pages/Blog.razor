@page "/blog"
@implements IDisposable

<PageTitle>Blog — powerm1nt</PageTitle>

<FileViewer FilePath="@(LangState?.IsJapanese == true ? "blog/index.ja.md" : "blog/index.md")"
            IsJapanese="@(LangState?.IsJapanese == true)" />

@code {
    [CascadingParameter] public Web.Services.LanguageState? LangState { get; set; }

    protected override void OnInitialized()
    {
        if (LangState is not null)
            LangState.OnChange += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (LangState is not null)
            LangState.OnChange -= OnLanguageChanged;
    }
}
